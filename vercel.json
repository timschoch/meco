{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Containerfile.gateway",
      "bindings": [
        {
          "type": "service",
          "service": "models",
          "format": "url",
          "env": "MODELS_URL"
        }
      ]
    },
    "models": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Containerfile.models"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "gateway"
      }
    }
  ]
}
