{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "packages/gateway/Containerfile",
      "bindings": [
        {
          "type": "service",
          "service": "models",
          "format": "url",
          "env": "MODELS_URL"
        }
      ]
    },
    "models": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "packages/models/Containerfile"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "gateway" } }]
}
