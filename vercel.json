{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "gateway": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Containerfile",
      "bindings": [
        {
          "type": "service",
          "service": "models",
          "format": "url",
          "env": "MODELS_URL"
        }
      ]
    },
    "models": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "front": {
      "root": "packages/front",
      "entrypoint": "server.ts",
      "bindings": [
        {
          "type": "service",
          "service": "gateway",
          "format": "url",
          "env": "GATEWAY_URL"
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/internal/sweep",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": {
        "service": "front"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "gateway"
      }
    }
  ]
}
