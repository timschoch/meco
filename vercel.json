{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "meco": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "meco-faces": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "packages/faces/Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/faces/(.*)", "destination": { "service": "meco-faces" } },
    { "source": "/(.*)", "destination": { "service": "meco" } }
  ]
}
