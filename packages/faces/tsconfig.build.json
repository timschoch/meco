// Production emit, mirroring the root package: the config above is a checker
// (`noEmit`) and also covers scripts/, this one compiles src/ only so dist/
// mirrors src/ one for one. `models/` is resolved from the package root, not
// relative to a source file, so the depth of dist/ does not matter here.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
