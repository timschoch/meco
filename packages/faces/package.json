{
  "name": "meco-faces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:detect": "tsx scripts/detect-test.ts",
    "test:objects": "tsx scripts/objects-test.ts",
    "verify:dfine": "tsx scripts/verify-dfine.ts",
    "test:embed": "tsx scripts/embed-test.ts",
    "dump:aligned": "tsx scripts/align-dump.ts",
    "dump:prints": "tsx scripts/print-dump.ts",
    "dump:karts": "tsx scripts/kart-dump.ts",
    "dump:objects": "tsx scripts/objects-dump.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "4.13.3",
    "onnxruntime-node": "^1.29.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
