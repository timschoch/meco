# models — the private service, reached only over the binding.
#
# The name of this file carries no meaning and cannot be made to. Vercel
# validates the `entrypoint` basename against a fixed list before it builds
# anything, and buildah then takes the build context from this file's own
# directory. So: a root-level file, named from that list, and `vercel.json`
# says which service it is. See DEPLOY.md.
#
# glibc, not musl: onnxruntime-node ships Linux binaries for glibc only
# (ADR-0007). The bundle leaves `onnxruntime-node` and `sharp` external, so the
# runtime stage carries a flat node_modules holding those two and their
# dependencies, pruned to this build's architecture.
FROM node:24-slim AS build
WORKDIR /app
# husky's install step needs a .git directory that is not in the build context.
# onnxruntime-node's postinstall would download CUDA libraries; the CPU binaries
# ship in the tarball.
ENV HUSKY=0 ONNXRUNTIME_NODE_INSTALL=skip
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @meco/models build
RUN pnpm --filter @meco/models --prod deploy --legacy /deploy
# onnxruntime-node ships ~280 MB of binaries across five platforms. Keep the
# one this image runs on. Docker/buildah set TARGETARCH as amd64 or arm64.
ARG TARGETARCH
RUN set -eu; \
    bin=/deploy/node_modules/onnxruntime-node/bin/napi-v6; \
    arch=$([ "$TARGETARCH" = "amd64" ] && echo x64 || echo arm64); \
    for platform in "$bin"/*; do [ "$platform" = "$bin/linux" ] || rm -rf "$platform"; done; \
    for a in "$bin"/linux/*; do [ "$a" = "$bin/linux/$arch" ] || rm -rf "$a"; done; \
    test -d "$bin/linux/$arch"

FROM node:24-slim AS runtime
WORKDIR /app
# The 1.29 Linux binary carries POSIX telemetry. A container that holds
# photographs uploads nothing (ADR-0007).
ENV NODE_ENV=production ORT_DISABLE_TELEMETRY=1 PORT=80
COPY --from=build --chown=node:node /deploy/node_modules ./node_modules
COPY --from=build --chown=node:node /app/packages/models/dist/bundle ./
USER node
EXPOSE 80
CMD ["node", "server.js"]
