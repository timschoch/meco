# This file sits at the repository root because buildah takes the build context
# from the Containerfile's own directory, NOT from the service's `root`. A pnpm
# workspace cannot install from a single package directory, so the context has
# to be the top. See DEPLOY.md.
FROM node:22-alpine AS build
WORKDIR /app
# husky's install step needs a .git directory that is not in the build context.
ENV HUSKY=0
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @meco/models build

FROM node:22-alpine AS runtime
WORKDIR /app
COPY --from=build --chown=node:node /app/packages/models/dist/bundle ./
USER node
ENV PORT=80
EXPOSE 80
CMD ["node", "server.js"]
