{
  "name": "meco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "build": "pnpm --recursive --filter \"./packages/**\" build",
    "lint:boundaries": "depcruise .",
    "check": "pnpm typecheck && pnpm lint:boundaries && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
