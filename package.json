{
  "name": "meco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test:ui": "tsx scripts/ui-test.mjs",
    "test:mcp": "tsx scripts/mcp-probe.ts",
    "test:crop": "tsx scripts/crop-solver-test.ts",
    "test:match": "tsx scripts/match-calibration.ts",
    "test:http": "tsx scripts/http-probe.ts",
    "test:storage": "tsx scripts/storage-contract.ts",
    "typecheck:faces": "pnpm --filter meco-faces typecheck",
    "build:faces": "pnpm --filter meco-faces build",
    "test:detect": "pnpm --filter meco-faces test:detect",
    "test:objects": "pnpm --filter meco-faces test:objects",
    "test:embed": "pnpm --filter meco-faces test:embed"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@takumi-rs/core": "^2.12.0",
    "@takumi-rs/helpers": "^2.12.0",
    "@vercel/blob": "^2.8.0",
    "hono": "4.13.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "takumi-js": "^2.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
