{
  "name": "meco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "build": "pnpm --recursive --filter \"./packages/**\" build",
    "lint:boundaries": "depcruise .",
    "check": "pnpm typecheck && pnpm lint:boundaries && pnpm test",
    "prepare": "(test ! -e .git || lefthook install --reset-hooks-path)",
    "test:store:live": "vitest run --config vitest.live.config.ts packages/store",
    "test:records:live": "vitest run --config vitest.live.config.ts packages/records",
    "test:identify:live": "vitest run --config vitest.live.config.ts packages/identify",
    "records:seed": "pnpm --filter @meco/records seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "lefthook": "2.2.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
