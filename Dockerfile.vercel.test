# Build-test only copy of Dockerfile.vercel that swaps in a placeholder
# src/server.ts (which doesn't exist yet) so the real Dockerfile.vercel
# can be validated before another agent lands src/server.ts.
# Not deployed; delete after verification.

FROM node:24-slim AS deps
WORKDIR /app
RUN npm install -g pnpm@11
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:24-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY src ./src
COPY assets ./assets
COPY .temp/server-placeholder.ts ./src/server.ts

EXPOSE 80
CMD ["node_modules/.bin/tsx", "src/server.ts"]
